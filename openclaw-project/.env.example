# Copy to .env here and/or merge into ~/.openclaw/.env (Gateway loads ~/.openclaw/.env automatically).
# Do not commit .env with real secrets.
#
# This folder is standalone (not part of DePhalanx). Place the whole `openclaw-project`
# directory under: /Users/cass/DefiProject/openclaw-project/

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- LLM (set what you use) ---
OPENAI_API_KEY=
# Gemini API (optional; run: openclaw onboard --auth-choice gemini-api-key)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- Agent workspace (must match agents.defaults.workspace in ~/.openclaw/openclaw.json) ---
# Default: this repo on your Mac
OPENCLAW_PROJECT_WORKSPACE=${HOME}/DefiProject/openclaw-project/workspace

# --- Gateway (local Control UI / CLI; not Telegram) ---
OPENCLAW_GATEWAY_TOKEN=

# Optional: numeric Telegram user ID for dmPolicy allowlist (see README).
# TELEGRAM_USER_ID=
