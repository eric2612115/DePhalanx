# Copy to .env here and/or merge into ~/.openclaw/.env (Gateway loads ~/.openclaw/.env automatically).
# Do not commit .env with real secrets.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- LLM (set what you use) ---
# Default OpenClaw model path often uses OpenAI:
OPENAI_API_KEY=
# If you use Gemini API instead, set one of these (see README):
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- Agent workspace (must match agents.defaults.workspace in ~/.openclaw/openclaw.json) ---
# Put this repo under ~/DefiProject/ so the workspace path is:
#   ${HOME}/DefiProject/defiproject/openclaw/workspace
# If you only copied the inner "openclaw" folder to ~/DefiProject/openclaw/, use instead:
#   ${HOME}/DefiProject/openclaw/workspace
DEFIPROJECT_OPENCLAW_WORKSPACE=${HOME}/DefiProject/defiproject/openclaw/workspace

# --- Gateway (local Control UI / CLI; not Telegram) ---
OPENCLAW_GATEWAY_TOKEN=

# Optional: numeric Telegram user ID if you use dmPolicy allowlist (see README).
# TELEGRAM_USER_ID=
