# Copy to .env in this folder and fill in. OpenClaw also loads ~/.openclaw/.env — you may merge these there for the gateway daemon.

# Required for Telegram: BotFather token (this IS the API credential; there is no separate "agent–Telegram bridge token").
TELEGRAM_BOT_TOKEN=

# Absolute path to this project's agent workspace (skills, prompts, etc.).
DEFIPROJECT_OPENCLAW_WORKSPACE=/absolute/path/to/defiproject/openclaw/workspace

# Optional but recommended: shared secret for Gateway HTTP/WS (Control UI, CLI when auth enabled). NOT the Telegram bot token.
OPENCLAW_GATEWAY_TOKEN=

# Optional: your numeric Telegram user ID for allowlist mode (see README).
# TELEGRAM_USER_ID=
